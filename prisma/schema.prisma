generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  phoneNumber     String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  isPhoneVerified Boolean        @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  otpUsedAt       DateTime?
  pin             String
  firstName       String?
  lastName        String?
  middleName      String?
  role            UserRole       @default(USER)
  activityLogs    ActivityLog[]
  groups          Group[]
  groupMembers    GroupMembers[]
}

model Group {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  contributionAmount Int
  status             GroupStatus    @default(ACTIVE)
  durationMonths     Int?
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  activityLogs       ActivityLog[]
  createdBy          User           @relation(fields: [createdById], references: [id])
  cycles             GroupCycle[]
  members            GroupMembers[]
}

model GroupMembers {
  id               String         @id @default(uuid())
  groupId          String
  userId           String
  role             MemberRole     @default(MEMBER)
  rotationPosition Int
  hasReceived      Boolean        @default(false)
  joinedAt         DateTime       @default(now())
  contributions    Contribution[]
  group            Group          @relation(fields: [groupId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@unique([groupId, rotationPosition])
  @@index([groupId])
  @@index([userId])
}

model GroupCycle {
  id                String         @id @default(uuid())
  groupId           String
  periodKey         String
  dueDate           DateTime
  status            CycleStatus    @default(ACTIVE)
  payoutToMemberId  String?
  payoutConfirmedAt DateTime?
  contributions     Contribution[]
  group             Group          @relation(fields: [groupId], references: [id])

  @@unique([groupId, periodKey])
  @@index([groupId])
  @@index([status])
}

model Contribution {
  id       String        @id @default(uuid())
  cycleId  String
  memberId String
  amount   Int
  status   PaymentStatus @default(UNPAID)
  paidAt   DateTime?
  cycle    GroupCycle    @relation(fields: [cycleId], references: [id])
  member   GroupMembers  @relation(fields: [memberId], references: [id])

  @@unique([cycleId, memberId])
  @@index([cycleId])
  @@index([memberId])
  @@index([status])
}

model ActivityLog {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

enum UserRole {
  ADMIN
  USER
}

enum GroupStatus {
  ACTIVE
  CLOSED
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum CycleStatus {
  ACTIVE
  CLOSED
}

enum PaymentStatus {
  PAID
  UNPAID
}
